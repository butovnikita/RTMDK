# RTMDK Environment Configuration
# Copy this file to .env and edit as needed:
#   cp .env.example .env

# ─────────────────────────────────────────────────────────────
# SERVER SETTINGS
# ─────────────────────────────────────────────────────────────

# Host to bind the server (0.0.0.0 = all interfaces)
RTMDK_HOST=0.0.0.0

# Port to listen on
RTMDK_PORT=8080

# API key for authentication (set to empty string to disable)
RTMDK_API_KEY=rtmdk-local

# Log format: text or json
RTMDK_LOG_FORMAT=text

# ─────────────────────────────────────────────────────────────
# MEMORY SETTINGS
# ─────────────────────────────────────────────────────────────

# Path inside container to save memory state
RTMDK_MEMORY_FILE=/data/memory.json

# Auto-save interval in seconds (0 to disable)
RTMDK_AUTO_SAVE=60

# ─────────────────────────────────────────────────────────────
# API PROVIDER SELECTION
# ─────────────────────────────────────────────────────────────

# Supported providers: lm_studio | openrouter | openai | anthropic
RTMDK_API_PROVIDER=lm_studio

# Timeout for API requests in seconds
RTMDK_API_TIMEOUT=30

# ─────────────────────────────────────────────────────────────
# LM STUDIO (local, free)
# ─────────────────────────────────────────────────────────────

# LM Studio API URL
# For Docker with host LM Studio: http://host.docker.internal:12345/v1
# For local Python: http://localhost:12345/v1
LM_STUDIO_URL=http://host.docker.internal:12345/v1

# Embedding model name in LM Studio
RTMDK_EMBED_MODEL=nomic-ai/nomic-embed-text-v1.5-GGUF

# ─────────────────────────────────────────────────────────────
# OPENROUTER (unified API, many models)
# ─────────────────────────────────────────────────────────────

# Get key from: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-YOUR_KEY_HERE

# Model to use (see https://openrouter.ai/models)
# Popular choices: anthropic/claude-3.5-sonnet, openai/gpt-4o, meta-llama/llama-3-70b-instruct
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet

# OpenRouter base URL (usually no need to change)
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ─────────────────────────────────────────────────────────────
# OPENAI (official API)
# ─────────────────────────────────────────────────────────────

# Get key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-YOUR_KEY_HERE

# Model to use: gpt-4o, gpt-4o-mini, gpt-3.5-turbo
OPENAI_MODEL=gpt-4o

# OpenAI base URL (usually no need to change)
OPENAI_BASE_URL=https://api.openai.com/v1

# ─────────────────────────────────────────────────────────────
# ANTHROPIC (official API)
# ─────────────────────────────────────────────────────────────

# Get key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-YOUR_KEY_HERE

# Model to use: claude-3-5-sonnet-20241022, claude-3-opus-20240229
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# ─────────────────────────────────────────────────────────────
# ANY OPENAI-COMPATIBLE API
# ─────────────────────────────────────────────────────────────

# For any service that implements OpenAI API format:
# - Groq: https://console.groq.com/
# - Together AI: https://api.together.xyz/
# - LocalAI: self-hosted
CUSTOM_API_URL=
CUSTOM_API_KEY=
CUSTOM_API_MODEL=
