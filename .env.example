# RTMDK Configuration
# Copy this file to .env and edit the values as needed.

# Server settings
RTMDK_HOST=0.0.0.0
RTMDK_PORT=8080

# Memory file location
RTMDK_MEMORY_FILE=~/.rtmdk/memory.json

# LM Studio settings
LM_STUDIO_URL=http://localhost:12345/v1
RTMDK_LM_STUDIO_TIMEOUT=120

# Embedder settings
RTMDK_EMBED_MODEL=nomic-embed-text-v1.5

# Auto-save interval (seconds)
RTMDK_AUTO_SAVE_INTERVAL=60

# API key (optional)
RTMDK_API_KEY=rtmdk-local

# Cache settings
RTMDK_CACHE_MAX_SIZE=100000
RTMDK_BACKUP_DIR=~/.rtmdk/backups
RTMDK_SESSION_DIR=~/.rtmdk/sessions
RTMDK_CACHE_DIR=~/.rtmdk/embedding_cache

# Pipeline settings (v8.3+)
# Enable explicit pipeline architecture for retrieve_nodes()
# RTMDK_PIPELINE_ENABLED=false

# Circuit breaker settings
# RTMDK_PIPELINE_BREAKER_ENABLED=true
# RTMDK_PIPELINE_BREAKER_FAILURE_THRESHOLD=5
# RTMDK_PIPELINE_BREAKER_LATENCY_VIOLATION_THRESHOLD=3
# RTMDK_PIPELINE_BREAKER_RECOVERY_TIMEOUT_MS=30000

# Pipeline rate limit (stricter than general rate limit)
# RTMDK_PIPELINE_RATE_LIMIT_PER_MINUTE=30

# Pipeline metrics persistence
# RTMDK_PIPELINE_METRICS_PATH=~/.rtmdk/pipeline_metrics.jsonl

# System prompt (customize AI assistant personality)
# Option 1: Use config preset's default (set to empty to disable)
#   RTMDK_SYSTEM_PROMPT=""   → No system prompt (for SillyTavern)
#   RTMDK_SYSTEM_PROMPT="..." → Custom prompt
# Option 2: File path (overrides RTMDK_SYSTEM_PROMPT if both set)
# RTMDK_SYSTEM_PROMPT_FILE=/path/to/system_prompt.txt
#
# For SillyTavern: use RTMDK_PRESET=sillytavern or set RTMDK_SYSTEM_PROMPT=""
