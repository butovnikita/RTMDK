# RTMDK Environment Configuration — v8.0 Full
# Copy: cp .env.example .env

# ═══════════════════════════════════════════════════════════
# SERVER
# ═══════════════════════════════════════════════════════════
RTMDK_HOST=0.0.0.0
RTMDK_PORT=8080
RTMDK_API_KEY=rtmdk-local
RTMDK_LOG_FORMAT=text

# ═══════════════════════════════════════════════════════════
# MEMORY
# ═══════════════════════════════════════════════════════════
RTMDK_MEMORY_FILE=/data/memory.json
RTMDK_AUTO_SAVE=60

# ═══════════════════════════════════════════════════════════
# API PROVIDER: lm_studio | openrouter | openai | anthropic | custom
# ═══════════════════════════════════════════════════════════
RTMDK_API_PROVIDER=lm_studio
RTMDK_API_TIMEOUT=30

# ═══════════════════════════════════════════════════════════
# LM STUDIO (local, free)
# ═══════════════════════════════════════════════════════════
RTMDK_ENABLE_LM_STUDIO=true
LM_STUDIO_URL=http://host.docker.internal:12345/v1
RTMDK_EMBED_MODEL=nomic-ai/nomic-embed-text-v1.5-GGUF

# ═══════════════════════════════════════════════════════════
# OPENROUTER (unified API)
# ═══════════════════════════════════════════════════════════
OPENROUTER_API_KEY=sk-or-v1-YOUR_KEY
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ═══════════════════════════════════════════════════════════
# OPENAI (official)
# ═══════════════════════════════════════════════════════════
OPENAI_API_KEY=sk-proj-YOUR_KEY
OPENAI_MODEL=gpt-4o
OPENAI_BASE_URL=https://api.openai.com/v1

# ═══════════════════════════════════════════════════════════
# ANTHROPIC (official)
# ═══════════════════════════════════════════════════════════
ANTHROPIC_API_KEY=sk-ant-YOUR_KEY
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# ═══════════════════════════════════════════════════════════
# CUSTOM (any OpenAI-compatible: Groq, Together, LocalAI)
# ═══════════════════════════════════════════════════════════
CUSTOM_API_URL=
CUSTOM_API_KEY=
CUSTOM_API_MODEL=

# ═══════════════════════════════════════════════════════════
# UX FEATURES
# ═══════════════════════════════════════════════════════════

# ── Storage dirs (inside container) ──
RTMDK_BACKUP_DIR=/data/backups
RTMDK_SESSION_DIR=/data/sessions
RTMDK_CACHE_DIR=/data/embedding_cache

# ── Backup ──
RTMDK_BACKUP_COMPRESSION=true
RTMDK_BACKUP_ROTATION=5

# ── Session auto-save (seconds) ──
RTMDK_AUTO_SAVE_INTERVAL=60

# ── Smart Pruning ──
RTMDK_PRUNE_AGE_DAYS=90
RTMDK_PRUNE_MIN_SALIENCE=0.05

# ── Rate Limiting ──
RTMDK_RATE_LIMIT_PER_MINUTE=60
RTMDK_RATE_LIMIT_PER_HOUR=1000

# ── Embedding Cache ──
RTMDK_CACHE_MAX_SIZE=100000

# ── Context Optimization ──
RTMDK_MAX_CONTEXT_TOKENS=300
RTMDK_LLM_MODEL=default

# ── Feedback Loop ──
RTMDK_FEEDBACK_LR=0.05
