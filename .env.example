# RTMDK Environment Configuration
# Copy this file to .env and edit as needed:
#   cp .env.example .env

# ─────────────────────────────────────────────────────────────
# SERVER SETTINGS
# ─────────────────────────────────────────────────────────────

# Host to bind the server (0.0.0.0 = all interfaces)
RTMDK_HOST=0.0.0.0

# Port to listen on
RTMDK_PORT=8080

# API key for authentication (set to empty string to disable)
RTMDK_API_KEY=rtmdk-local

# Log format: text or json
RTMDK_LOG_FORMAT=text

# ─────────────────────────────────────────────────────────────
# MEMORY SETTINGS
# ─────────────────────────────────────────────────────────────

# Path inside container to save memory state
RTMDK_MEMORY_FILE=/data/memory.json

# Auto-save interval in seconds (0 to disable)
RTMDK_AUTO_SAVE=60

# ─────────────────────────────────────────────────────────────
# LM STUDIO INTEGRATION (Embeddings + Chat)
# ─────────────────────────────────────────────────────────────

# Enable LM Studio integration (true/false)
RTMDK_ENABLE_LM_STUDIO=true

# LM Studio API URL
# For Docker with host LM Studio: http://host.docker.internal:12345/v1
# For local Python: http://localhost:12345/v1
LM_STUDIO_URL=http://host.docker.internal:12345/v1

# Embedding model name in LM Studio
RTMDK_EMBED_MODEL=nomic-ai/nomic-embed-text-v1.5-GGUF

# Timeout for LM Studio requests in seconds
RTMDK_LM_STUDIO_TIMEOUT=30
