# RTMDK Home / SillyTavern Docker Image
# Includes SillyTavern compatibility and proxy server.
FROM python:3.10-slim

WORKDIR /app

# System dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Python dependencies (full set for home use)
COPY requirements-home.txt .
RUN pip install --no-cache-dir -r requirements-home.txt

# Copy the rtmdk package
COPY rtmdk/ ./rtmdk/

# Copy all server files (monolith with ST compat)
COPY rtmdk_server.py .
COPY rtmdk_server_ux.py .
COPY rtmdk_dashboard_ui.py .
COPY rtmdk_sillytavern_compat.py .
COPY rtmdk_st_proxy.py .
COPY rtmdk_sillytavern_launcher.py .
COPY rtmdk_memory_v8.py .
COPY embedder_lmstudio.py .

# Copy SillyTavern config
COPY st_config.json .

# Create data directories
RUN mkdir -p /root/.rtmdk \
    /root/.rtmdk/backups \
    /root/.rtmdk/sessions \
    /root/.rtmdk/embedding_cache

# Set environment variables
ENV PYTHONUNBUFFERED=1 \
    RTMDK_MEMORY_FILE=/root/.rtmdk/memory.json \
    RTMDK_AUTO_SAVE_INTERVAL=60 \
    RTMDK_LM_STUDIO_TIMEOUT=120 \
    RTMDK_ENABLE_LM_STUDIO=true

# Expose ports: 8080 = main server, 5000 = ST proxy
EXPOSE 8080 5000

# Health check (main server)
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD curl -f http://localhost:8080/health || exit 1

# Default command — launcher starts both server and proxy
CMD ["python", "rtmdk_sillytavern_launcher.py"]
