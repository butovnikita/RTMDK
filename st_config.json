{
  "rtmdk_url": "http://127.0.0.1:8080",
  "lm_studio_url": "http://127.0.0.1:12345/v1",
  "proxy_port": 5000,
  
  "memory": {
    "save_user_messages": true,
    "save_ai_messages": true,
